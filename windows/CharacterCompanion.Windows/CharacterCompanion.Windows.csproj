<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CharacterCompanion.Windows</AssemblyName>
    <RootNamespace>CharacterCompanion.Windows</RootNamespace>
    <Version>0.11.0</Version>
    <!-- A self-contained CefSharp publish needs the host EXE to run renderer/GPU children. -->
    <StartupObject>CharacterCompanion.Windows.Program</StartupObject>
    <!-- CEF subprocesses must execute this actual .exe, never dotnet.exe. -->
    <UseAppHost>true</UseAppHost>
    <CefSharpExcludeSubProcessExe>true</CefSharpExcludeSubProcessExe>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- CEF binaries ship beside the app; no OS browser runtime installation. -->
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="156.0.300" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>
</Project>
