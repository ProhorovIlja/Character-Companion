<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#A8B8FF</item>
        <item name="android:colorBackground">#111319</item>
        <item name="android:colorBackgroundFloating">#191C25</item>
        <item name="android:colorControlHighlight">#33A8B8FF</item>
        <item name="android:buttonStyle">@style/CompanionButton</item>
        <item name="shellText">#E4E7F0</item>
        <item name="shellMuted">#ABB2C3</item>
        <item name="shellAccent">#A8B8FF</item>
        <item name="shellRipple">#33A8B8FF</item>
        <item name="shellDisabledText">#818899</item>
        <item name="shellDisabledAction">#191C25</item>
        <item name="shellOnAccent">#10172B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#14161D</item>
        <item name="android:navigationBarColor">#14161D</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111319</item>
        <item name="shellBackground">#111319</item>
        <item name="shellChrome">#191C25</item>
        <item name="shellPanel">#191C25</item>
        <item name="shellAction">#222631</item>
        <item name="shellOutline">#343B4D</item>
    </style>
    <style name="AppTheme.Amoled" parent="AppTheme">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorBackgroundFloating">#0D0D0D</item>
        <item name="shellDisabledAction">#0D0D0D</item>
        <item name="shellBackground">#000000</item>
        <item name="shellChrome">#000000</item>
        <item name="shellPanel">#0D0D0D</item>
        <item name="shellAction">#141414</item>
        <item name="shellOutline">#383838</item>
    </style>
    <style name="CompanionButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/settings_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/shell_control_text</item>
    </style>
    <style name="NavButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/shell_control_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/shell_nav_feedback</item>
        <item name="android:layout_marginEnd">0dp</item>
    </style>
    <style name="FooterButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/shell_nav_feedback</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:focusable">true</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/shell_control_text</item>
    </style>
</resources>
